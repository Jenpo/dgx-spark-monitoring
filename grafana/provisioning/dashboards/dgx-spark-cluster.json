{
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "watt"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "DCGM_FI_DEV_POWER_USAGE",
          "legendFormat": "{{node}} GPU{{gpu}}",
          "refId": "A"
        }
      ],
      "title": "GPU 功耗 (W)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "legendFormat": "{{node}} GPU{{gpu}}",
          "refId": "A"
        }
      ],
      "title": "GPU 利用率 (%)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "DCGM_FI_DEV_MEM_COPY_UTIL",
          "legendFormat": "{{node}} memcopy",
          "refId": "A"
        },
        {
          "expr": "DCGM_FI_DEV_DEC_UTIL",
          "legendFormat": "{{node}} decode",
          "refId": "B"
        },
        {
          "expr": "DCGM_FI_DEV_ENC_UTIL",
          "legendFormat": "{{node}} encode",
          "refId": "C"
        }
      ],
      "title": "GPU 引擎利用率 (MEM拷贝/解码/编码 %)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_TEMP",
          "legendFormat": "{{node}} core",
          "refId": "A"
        },
        {
          "expr": "DCGM_FI_DEV_MEMORY_TEMP",
          "legendFormat": "{{node}} mem",
          "refId": "B"
        }
      ],
      "title": "GPU 温度 (核心/显存 °C)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "hertz"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "id": 5,
      "targets": [
        {
          "expr": "DCGM_FI_DEV_SM_CLOCK",
          "legendFormat": "{{node}} GPU{{gpu}}",
          "refId": "A"
        }
      ],
      "title": "GPU SM 时钟 (MHz)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "milliwatthour"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "id": 6,
      "targets": [
        {
          "expr": "DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION",
          "legendFormat": "{{node}} GPU{{gpu}}",
          "refId": "A"
        }
      ],
      "title": "GPU 累计能耗 (mWh)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 7,
      "targets": [
        {
          "expr": "max by (node) (node_thermal_zone_temp)",
          "legendFormat": "{{node}} max",
          "refId": "A"
        },
        {
          "expr": "avg by (node) (node_thermal_zone_temp)",
          "legendFormat": "{{node}} avg",
          "refId": "B"
        }
      ],
      "title": "CPU 温度 (max/avg °C)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 8,
      "targets": [
        {
          "expr": "100 - avg by (node) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100",
          "legendFormat": "{{node}} CPU%",
          "refId": "A"
        },
        {
          "expr": "node_load1",
          "legendFormat": "{{node}} load1",
          "refId": "B"
        },
        {
          "expr": "node_load5",
          "legendFormat": "{{node}} load5",
          "refId": "C"
        },
        {
          "expr": "node_load15",
          "legendFormat": "{{node}} load15",
          "refId": "D"
        }
      ],
      "title": "集群负载 (CPU使用率 / Load)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 9,
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes",
          "legendFormat": "{{node}} total",
          "refId": "A"
        },
        {
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "{{node}} available",
          "refId": "B"
        },
        {
          "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes",
          "legendFormat": "{{node}} swap used",
          "refId": "C"
        }
      ],
      "title": "内存 (可用/总量/Swap)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 10,
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"}",
          "legendFormat": "{{node}} /",
          "refId": "A"
        }
      ],
      "title": "磁盘可用空间",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 11,
      "targets": [
        {
          "expr": "sum by (node) (rate(node_network_receive_bytes_total{device!=\"lo\"}[1m]))",
          "legendFormat": "{{node}} rx",
          "refId": "A"
        },
        {
          "expr": "sum by (node) (rate(node_network_transmit_bytes_total{device!=\"lo\"}[1m]))",
          "legendFormat": "{{node}} tx",
          "refId": "B"
        }
      ],
      "title": "网络收发带宽 (bytes/s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tokps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 32
      },
      "id": 12,
      "targets": [
        {
          "expr": "rate(vllm:generation_tokens_total[1m])",
          "legendFormat": "{{model_name}} gen",
          "refId": "A"
        },
        {
          "expr": "rate(vllm:prompt_tokens_total[1m])",
          "legendFormat": "{{model_name}} prompt",
          "refId": "B"
        }
      ],
      "title": "推理吞吐 (tok/s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 32
      },
      "id": 13,
      "targets": [
        {
          "expr": "vllm:kv_cache_usage_perc",
          "legendFormat": "KV cache %",
          "refId": "A"
        },
        {
          "expr": "vllm:num_requests_running",
          "legendFormat": "running",
          "refId": "B"
        },
        {
          "expr": "vllm:num_requests_waiting",
          "legendFormat": "waiting",
          "refId": "C"
        }
      ],
      "title": "KV Cache 与请求队列",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "id": 14,
      "targets": [
        {
          "expr": "rate(vllm:inter_token_latency_seconds_sum[1m]) / rate(vllm:inter_token_latency_seconds_count[1m])",
          "legendFormat": "{{model_name}} TPOT",
          "refId": "A"
        },
        {
          "expr": "rate(vllm:request_prefill_time_seconds_sum[1m]) / rate(vllm:request_prefill_time_seconds_count[1m])",
          "legendFormat": "{{model_name}} TTFT",
          "refId": "B"
        },
        {
          "expr": "rate(vllm:request_queue_time_seconds_sum[1m]) / rate(vllm:request_queue_time_seconds_count[1m])",
          "legendFormat": "{{model_name}} queue",
          "refId": "C"
        }
      ],
      "title": "推理延迟 (TPOT/TTFT/排队 s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "GB10 特有：Grace CPU 与 Blackwell GPU 共享 128GB 统一内存（LPDDR5X），无独立 VRAM。node_memory 的 MemTotal 恒为 128GB，已用=CPU+GPU 共享部分。",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 40
      },
      "id": 15,
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes",
          "legendFormat": "总量 (128GB 一体化)",
          "refId": "A"
        },
        {
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "可用",
          "refId": "B"
        },
        {
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "已用 (CPU+GPU 共享)",
          "refId": "C"
        }
      ],
      "title": "GB10 统一内存 (128GB CPU+GPU 共享)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "GB10 特有散热实践：长时间推理建议把 SM 时钟锁频到 2200 MHz（GB10 硬件上限 3003 MHz）。双机实测：锁频后峰温 -8~12°C、GPU rail 功耗约 -36%，decode 差异在噪声内，cold prefill 约慢 3.9%，综合性能代价约 1%。虚线为 2200 锁频目标与 3003 硬件上限。",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "hertz",
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2200 锁频目标"
            },
            "properties": [
              {
                "id": "custom.dashStyle",
                "value": [
                  10,
                  10
                ]
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "3003 硬件上限"
            },
            "properties": [
              {
                "id": "custom.dashStyle",
                "value": [
                  5,
                  5
                ]
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "gray",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 40
      },
      "id": 16,
      "targets": [
        {
          "expr": "DCGM_FI_DEV_SM_CLOCK",
          "legendFormat": "{{node}} GPU{{gpu}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "2200",
          "legendFormat": "2200 锁频目标",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "3003",
          "legendFormat": "3003 硬件上限",
          "refId": "C"
        }
      ],
      "title": "SM Clock vs GB10 2200 MHz 锁频",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "GB10 热设计观测：GPU 功耗(W) 与 温度(°C) 同图双轴联动，可直接评估 2200MHz 锁频的降温与省电 trade-off（左轴功耗、右轴温度）。",
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "GPU 温度"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GPU 功耗"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watt"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 40
      },
      "id": 17,
      "targets": [
        {
          "expr": "DCGM_FI_DEV_POWER_USAGE",
          "legendFormat": "GPU 功耗",
          "refId": "A"
        },
        {
          "expr": "DCGM_FI_DEV_GPU_TEMP",
          "legendFormat": "GPU 温度",
          "refId": "B"
        }
      ],
      "title": "GB10 功耗–温度 (锁频热设计)",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": [
    "dgx",
    "spark",
    "gb10"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "DGX Spark 集群监控",
  "uid": "dgx-spark-dashboard",
  "version": 3
}