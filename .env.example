# DGX Spark 集群监控栈 配置示例
# 复制为 .env 后按需修改，然后运行 ./install.sh

# 运行监控栈的主机（node 1）地址
SPARK_NODE1_HOST=127.0.0.1

# 第二台 DGX Spark 地址（留空则只监控单机）
SPARK_NODE2_HOST=192.168.31.158

# vLLM 推理服务地址（留空则不采集推理指标）
VLLM_HOST=127.0.0.1

# Prometheus 数据保留时长
PROM_RETENTION=30d

# Grafana 管理员账号
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
